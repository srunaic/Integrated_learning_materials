<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="MainDashboard" width="1680" height="960" titletext="스마트시티 공공시설 및 시민 민원 통합관제 포털" onload="MainDashboard_onload" background="#f1f5f9">
    <Layouts>
      <Layout width="1680" height="960">
        <!-- 1. 최상단 관제센터 헤더 바 -->
        <Div id="div_header" left="20" top="15" right="20" height="65" background="#ffffff" border="1px solid #cbd5e1" borderRadius="6px" text="">
          <Layouts>
            <Layout>
              <Static id="st_icon" text="🏢" left="15" top="12" width="40" height="40" font="24px/normal 'Segoe UI Emoji'" textAlign="center"/>
              <Static id="st_main_title" text="스마트시티 공공시설 및 시민 민원 통합관제 포털" left="65" top="12" width="600" height="24" font="bold 18px 'Pretendard', 'Malgun Gothic'" color="#0f172a"/>
              <Static id="st_sub_title" text="eGovFrame 4.x • Nexacro UI/UX • Oracle Enterprise DB" left="65" top="36" width="600" height="18" font="bold 12px 'Pretendard'" color="#475569"/>
              <!-- 실시간 시계 -->
              <Static id="st_clock" text="2026. 10. 16. (금) 오전 12:22:54" right="20" top="18" width="260" height="28" font="bold 14px 'Pretendard', 'Malgun Gothic'" color="#0f172a" textAlign="right"/>
            </Layout>
          </Layouts>
        </Div>

        <!-- 2. 상단 핵심 4대 KPI 요약 카드 -->
        <!-- KPI 1: 총 등록 시설물 -->
        <Div id="kpi_fac" left="20" top="95" width="395" height="95" background="#ffffff" border="1px solid #cbd5e1" borderRadius="6px">
          <Layouts>
            <Layout>
              <Static id="st_k1_icon" text="🏢" left="20" top="20" width="45" height="45" font="32px/normal 'Segoe UI Emoji'" textAlign="center"/>
              <Static id="st_k1_lbl" text="총 등록 공공시설물" left="80" top="20" width="180" height="18" font="bold 12px 'Pretendard'" color="#64748b"/>
              <Static id="st_k1_val" text="150" left="80" top="42" width="90" height="36" font="800 24px 'Pretendard'" color="#0f172a"/>
              <Static id="st_k1_unit" text="개소" left="175" top="50" width="40" height="20" font="12px 'Pretendard'" color="#64748b"/>
            </Layout>
          </Layouts>
        </Div>

        <!-- KPI 2: 정상 가동 시설물 -->
        <Div id="kpi_rate" left="435" top="95" width="395" height="95" background="#ffffff" border="1px solid #cbd5e1" borderRadius="6px">
          <Layouts>
            <Layout>
              <Static id="st_k2_icon" text="⚡" left="20" top="20" width="45" height="45" font="32px/normal 'Segoe UI Emoji'" textAlign="center"/>
              <Static id="st_k2_lbl" text="정상 가동 시설물" left="80" top="20" width="180" height="18" font="bold 12px 'Pretendard'" color="#64748b"/>
              <Static id="st_k2_val" text="124" left="80" top="42" width="60" height="36" font="800 24px 'Pretendard'" color="#0f172a"/>
              <Static id="st_k2_unit" text="개동 (94.2%)" left="145" top="50" width="100" height="20" font="12px 'Pretendard'" color="#64748b"/>
            </Layout>
          </Layouts>
        </Div>

        <!-- KPI 3: 누적 민원 -->
        <Div id="kpi_cmp" left="850" top="95" width="395" height="95" background="#ffffff" border="1px solid #cbd5e1" borderRadius="6px">
          <Layouts>
            <Layout>
              <Static id="st_k3_icon" text="📢" left="20" top="20" width="45" height="45" font="32px/normal 'Segoe UI Emoji'" textAlign="center"/>
              <Static id="st_k3_lbl" text="시민 누적 접수 민원" left="80" top="20" width="180" height="18" font="bold 12px 'Pretendard'" color="#64748b"/>
              <Static id="st_k3_val" text="2,500" left="80" top="42" width="90" height="36" font="800 24px 'Pretendard'" color="#0f172a"/>
              <Static id="st_k3_unit" text="건" left="175" top="50" width="30" height="20" font="12px 'Pretendard'" color="#64748b"/>
            </Layout>
          </Layouts>
        </Div>

        <!-- KPI 4: 민원 조치 및 해결 완료 -->
        <Div id="kpi_alert" left="1265" top="95" right="20" height="95" background="#ffffff" border="1px solid #cbd5e1" borderRadius="6px">
          <Layouts>
            <Layout>
              <Static id="st_k4_icon" text="🛡️" left="20" top="20" width="45" height="45" font="32px/normal 'Segoe UI Emoji'" textAlign="center"/>
              <Static id="st_k4_lbl" text="민원 조치 및 해결 완료" left="80" top="20" width="180" height="18" font="bold 12px 'Pretendard'" color="#64748b"/>
              <Static id="st_k4_val" text="875" left="80" top="42" width="70" height="36" font="800 24px 'Pretendard'" color="#0f172a"/>
              <Static id="st_k4_unit" text="건" left="155" top="50" width="30" height="20" font="12px 'Pretendard'" color="#64748b"/>
            </Layout>
          </Layouts>
        </Div>

        <!-- 3. 좌측 영역: 공공 시설물 자산 마스터 그리드 -->
        <Static id="st_tab_left" text="시설물 자산 &amp; 점검 이력" left="20" top="205" width="200" height="30" background="#1e3a5f" color="#ffffff" font="bold 12px 'Pretendard'" textAlign="center" borderRadius="4px 4px 0px 0px"/>
        <Grid id="grd_fac_status" left="20" top="235" width="810" height="360" binddataset="ds_facilities" autofittype="col" background="#ffffff" border="1px solid #cbd5e1">
          <Formats>
            <Format id="default">
              <Columns>
                <Column size="105"/>
                <Column size="180"/>
                <Column size="100"/>
                <Column size="80"/>
                <Column size="80"/>
                <Column size="110"/>
              </Columns>
              <Rows>
                <Row size="32" band="head"/>
                <Row size="28"/>
              </Rows>
              <Band id="head">
                <Cell text="시설코드" background="#f1f5f9" color="#334155" font="bold 12px 'Pretendard'"/>
                <Cell col="1" text="시설명" background="#f1f5f9" color="#334155" font="bold 12px 'Pretendard'"/>
                <Cell col="2" text="유형" background="#f1f5f9" color="#334155" font="bold 12px 'Pretendard'"/>
                <Cell col="3" text="구역" background="#f1f5f9" color="#334155" font="bold 12px 'Pretendard'"/>
                <Cell col="4" text="가동상태" background="#f1f5f9" color="#334155" font="bold 12px 'Pretendard'"/>
                <Cell col="5" text="관리부서" background="#f1f5f9" color="#334155" font="bold 12px 'Pretendard'"/>
              </Band>
              <Band id="body">
                <Cell text="bind:FAC_ID" textAlign="center" color="#334155" font="11px 'Courier New'"/>
                <Cell col="1" text="bind:FAC_NAME" textAlign="left" color="#0f172a" font="bold 12px 'Pretendard'"/>
                <Cell col="2" text="bind:FAC_TYPE" textAlign="center" color="#0284c7" font="11px 'Pretendard'"/>
                <Cell col="3" text="bind:DISTRICT" textAlign="center" color="#334155" font="11px 'Pretendard'"/>
                <Cell col="4" text="bind:OP_STATUS" textAlign="center" font="bold 11px 'Pretendard'" color="expr:OP_STATUS=='NORMAL'?'#16a34a':'#ea580c'"/>
                <Cell col="5" text="bind:MANAGE_DEPT" textAlign="center" color="#64748b" font="11px 'Pretendard'"/>
              </Band>
            </Format>
          </Formats>
        </Grid>

        <!-- 4. 우측 영역: 넥사크로 시민 민원 관리 그리드 -->
        <Static id="st_tab_right" text="넥사크로 시민 민원 관리" left="850" top="205" width="200" height="30" background="#1e3a5f" color="#ffffff" font="bold 12px 'Pretendard'" textAlign="center" borderRadius="4px 4px 0px 0px"/>
        <Grid id="grd_complaints" left="850" top="235" right="20" height="360" binddataset="ds_complaints" autofittype="col" background="#ffffff" border="1px solid #cbd5e1">
          <Formats>
            <Format id="default">
              <Columns>
                <Column size="120"/>
                <Column size="90"/>
                <Column size="270"/>
                <Column size="75"/>
                <Column size="85"/>
                <Column size="80"/>
              </Columns>
              <Rows>
                <Row size="32" band="head"/>
                <Row size="28"/>
              </Rows>
              <Band id="head">
                <Cell text="접수번호" background="#f1f5f9" color="#334155" font="bold 12px 'Pretendard'"/>
                <Cell col="1" text="분류" background="#f1f5f9" color="#334155" font="bold 12px 'Pretendard'"/>
                <Cell col="2" text="민원 제목" background="#f1f5f9" color="#334155" font="bold 12px 'Pretendard'"/>
                <Cell col="3" text="자치구" background="#f1f5f9" color="#334155" font="bold 12px 'Pretendard'"/>
                <Cell col="4" text="민원인" background="#f1f5f9" color="#334155" font="bold 12px 'Pretendard'"/>
                <Cell col="5" text="처리상태" background="#f1f5f9" color="#334155" font="bold 12px 'Pretendard'"/>
              </Band>
              <Band id="body">
                <Cell text="bind:COMPLAINT_ID" textAlign="center" color="#334155" font="bold 11px 'Courier New'"/>
                <Cell col="1" text="bind:CATEGORY" textAlign="center" color="#0284c7" font="11px 'Pretendard'"/>
                <Cell col="2" text="bind:TITLE" textAlign="left" color="#0f172a" font="12px 'Pretendard'"/>
                <Cell col="3" text="bind:DISTRICT" textAlign="center" color="#334155" font="11px 'Pretendard'"/>
                <Cell col="4" text="bind:PETITIONER_NAME" textAlign="center" color="#64748b" font="11px 'Pretendard'"/>
                <Cell col="5" text="bind:STATUS" textAlign="center" font="bold 11px 'Pretendard'" color="#0d9488"/>
              </Band>
            </Format>
          </Formats>
        </Grid>

        <!-- 5. 하단 영역: IoT 센서 텔레메트리 -->
        <Static id="st_tab_bottom" text="IoT 센서 텔레메트리" left="20" top="610" width="200" height="30" background="#1e3a5f" color="#ffffff" font="bold 12px 'Pretendard'" textAlign="center" borderRadius="4px 4px 0px 0px"/>
        <Grid id="grd_sensor" left="20" top="640" right="20" bottom="35" binddataset="ds_sensors" autofittype="col" background="#ffffff" border="1px solid #cbd5e1">
          <Formats>
            <Format id="default">
              <Columns>
                <Column size="70"/>
                <Column size="140"/>
                <Column size="140"/>
                <Column size="130"/>
                <Column size="110"/>
                <Column size="180"/>
              </Columns>
              <Rows>
                <Row size="32" band="head"/>
                <Row size="28"/>
              </Rows>
              <Band id="head">
                <Cell text="No" background="#f1f5f9" color="#334155" font="bold 12px 'Pretendard'"/>
                <Cell col="1" text="대상 시설물 코드" background="#f1f5f9" color="#334155" font="bold 12px 'Pretendard'"/>
                <Cell col="2" text="계측 센서 종류" background="#f1f5f9" color="#334155" font="bold 12px 'Pretendard'"/>
                <Cell col="3" text="실시간 계측값" background="#f1f5f9" color="#334155" font="bold 12px 'Pretendard'"/>
                <Cell col="4" text="이상 여부" background="#f1f5f9" color="#334155" font="bold 12px 'Pretendard'"/>
                <Cell col="5" text="계측 일시" background="#f1f5f9" color="#334155" font="bold 12px 'Pretendard'"/>
              </Band>
              <Band id="body">
                <Cell text="bind:LOG_ID" textAlign="center" color="#64748b"/>
                <Cell col="1" text="bind:FAC_ID" textAlign="center" color="#0284c7" font="bold 11px 'Courier New'"/>
                <Cell col="2" text="bind:SENSOR_TYPE" textAlign="center" color="#334155"/>
                <Cell col="3" text="expr:METRIC_VAL + ' ' + UNIT" textAlign="right" color="#0f172a" font="bold 11px 'Courier New'"/>
                <Cell col="4" text="bind:STATUS_FLAG" textAlign="center" font="bold 11px 'Pretendard'" color="expr:STATUS_FLAG=='OK'?'#16a34a':'#ea580c'"/>
                <Cell col="5" text="bind:LOGGED_AT" textAlign="center" color="#64748b"/>
              </Band>
            </Format>
          </Formats>
        </Grid>

        <!-- 푸터 -->
        <Static id="st_footer" text="eGovFrame 4.x • Nexacro UI/UX • Oracle Enterprise DB" right="20" bottom="8" width="400" height="20" font="bold 11px 'Pretendard'" color="#475569" textAlign="right"/>
      </Layout>
    </Layouts>

    <!-- 데이터셋 정의 -->
    <Objects>
      <Dataset id="ds_facilities">
        <ColumnInfo>
          <Column id="FAC_ID" type="STRING" size="30"/>
          <Column id="FAC_NAME" type="STRING" size="150"/>
          <Column id="FAC_TYPE" type="STRING" size="50"/>
          <Column id="DISTRICT" type="STRING" size="50"/>
          <Column id="OP_STATUS" type="STRING" size="20"/>
          <Column id="MANAGE_DEPT" type="STRING" size="50"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_complaints">
        <ColumnInfo>
          <Column id="COMPLAINT_ID" type="STRING" size="30"/>
          <Column id="CATEGORY" type="STRING" size="50"/>
          <Column id="TITLE" type="STRING" size="200"/>
          <Column id="DISTRICT" type="STRING" size="50"/>
          <Column id="PETITIONER_NAME" type="STRING" size="50"/>
          <Column id="STATUS" type="STRING" size="20"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_sensors">
        <ColumnInfo>
          <Column id="LOG_ID" type="INT" size="10"/>
          <Column id="FAC_ID" type="STRING" size="30"/>
          <Column id="SENSOR_TYPE" type="STRING" size="30"/>
          <Column id="METRIC_VAL" type="FLOAT" size="10"/>
          <Column id="UNIT" type="STRING" size="10"/>
          <Column id="STATUS_FLAG" type="STRING" size="10"/>
          <Column id="LOGGED_AT" type="STRING" size="30"/>
        </ColumnInfo>
      </Dataset>
    </Objects>

    <!-- 스크립트 -->
    <Script type="xscript5.1"><![CDATA[
this.MainDashboard_onload = function(obj, e) {
    trace("[NEXACRO] 스마트시티 관제 대시보드 로딩 완료");
    this.fn_loadDashboardData();
};

this.fn_loadDashboardData = function() {
    this.transaction("getFacilities", "svc_backend::facilities", "", "ds_facilities=ds_facilities", "", "fn_callback");
    this.transaction("getComplaints", "svc_backend::complaints?page=1&pageSize=15", "", "ds_complaints=ds_complaints", "", "fn_callback");
};

this.fn_callback = function(svcId, errCode, errMsg) {
    if (errCode < 0) {
        trace("[WARN] 백엔드 오프라인 - 데모 모드 작동: " + errMsg);
    }
};
]]></Script>
  </Form>
</FDL>
