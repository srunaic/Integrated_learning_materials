<?xml version="1.0" encoding="utf-8"?>
<ADL version="2.0">
  <Application id="Application_Desktop" screenid="Desktop_screen">
    <Layout>
      <MainFrame id="mainframe" title="스마트시티 공공시설 및 민원 통합관제 시스템" left="0" top="0" width="1920" height="1080">
        <ChildFrame id="WorkFrame" formurl="form::MainDashboard.xfdl" showtitlebar="true" showstatusbar="true"/>
      </MainFrame>
    </Layout>
  </Application>
  <Script type="xscript5.1"><![CDATA[
this.Application_onload = function(obj, e) {
    trace("[SYSTEM] SmartCity Nexacro Application Loaded successfully.");
};
]]></Script>
</ADL>
